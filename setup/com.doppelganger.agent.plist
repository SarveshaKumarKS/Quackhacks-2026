<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.doppelganger.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd "$HOME/Quackhacks-2026/agent-server" &amp;&amp; exec python3 main.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/clone/Quackhacks-2026/agent-server</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/clone/Library/Logs/DoppelgangerOS/agent.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/clone/Library/Logs/DoppelgangerOS/agent.err.log</string>
</dict>
</plist>
