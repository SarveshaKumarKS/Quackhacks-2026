# ==============================================================================
# Doppelgänger OS — Environment Configuration Template
# Place this file as '.env' in your 'orchestrator/' directory on Profile A ONLY.
# NEVER share or commit actual secrets, and do NOT copy this to Profile B.
# ==============================================================================

# User configuration
USER_NAME="Sarvesha"                  # Name Jarvis will address you by in spoken cues

# API Keys
GOOGLE_API_KEY="your-gemini-api-key-here"  # Required for gemini-3-flash-preview Computer Use
ELEVENLABS_API_KEY="your-elevenlabs-api-key-here"  # Required for spoken notifications
ELEVENLABS_VOICE_ID="Jarvis"          # Name or specific ID of ElevenLabs preset voice

# Google Cloud Platform (BigQuery + Cloud APIs)
GCP_PROJECT_ID="your-gcp-project-id"  # GCP project containing BigQuery
GOOGLE_APPLICATION_CREDENTIALS="keys/gcp-service-account.json"  # Path to Service Account JSON key

# Inter-profile Services Settings
ORCHESTRATOR_PORT=8420                 # Port the orchestrator process listens on (Profile A)
AGENT_SERVER_PORT=8421                 # Port the agent-server process listens on (Profile B)
AGENT_SERVER_URL="http://localhost:8421"  # Address the orchestrator uses to contact the agent-server
CDP_PORT=9222                          # Chrome DevTools Protocol port (Profile B)

# Task Outputs (Google Workspace Cloud Doc and Sheet)
GOOGLE_DOC_ID="your-target-google-doc-id-here"      # MCP destination for research notes
GOOGLE_SHEET_ID="your-target-google-sheet-id-here"  # MCP destination for progress tracker

# [P2 Stretch] Session Transplant Options
ENABLE_SESSION_TRANSPLANT="false"       # Set to "true" to let Profile B inherit Profile A browser cookies
PROFILE_A_CDP_PORT=9223                  # Profile A Chrome CDP remote debugging port
